{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/data/country-outage-general-read-model.schema.json",
  "title": "国家中断通用观测页不可变事件读模型",
  "description": "只描述 224-310、RRC25-only 的 S4 根 manifest；大集合保留在 S1-S3 审计制品，正常读模型仅保存有界趋势、稳定分页行和每条路径关联最多三个真实样本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "run_id", "dataset_id", "collector_id",
    "window_start_utc", "window_end_exclusive_utc", "implementation_id",
    "source_event_cohort_dataset_id", "source_event_cohort_content_sha256",
    "source_event_cohort_manifest_sha256", "source_event_metric_dataset_id",
    "source_event_metric_content_sha256", "source_event_metric_manifest_sha256",
    "source_event_as_path_dataset_id", "source_event_as_path_content_sha256",
    "source_event_as_path_manifest_sha256", "source_lifecycle_snapshot_id",
    "source_lifecycle_snapshot_content_sha256", "api_read_semantics",
    "pagination_semantics", "path_evidence_semantics", "causal_boundary",
    "event_count", "state_point_count", "affected_as_count",
    "path_downstream_relation_count", "path_sample_count", "events",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "country-outage-general-read-model-store/v1"},
    "status": {"const": "complete"},
    "run_id": {"pattern": "^general_read_model_run_v1_[0-9a-f]{32}$"},
    "dataset_id": {"pattern": "^general_read_model_dataset_v1_[0-9a-f]{32}$"},
    "collector_id": {"const": "rrc25"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "implementation_id": {"pattern": "^git:[0-9a-f]{40}$"},
    "source_event_cohort_dataset_id": {"pattern": "^event_cohort_dataset_v1_[0-9a-f]{32}$"},
    "source_event_cohort_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_metric_dataset_id": {"pattern": "^event_metric_dataset_v1_[0-9a-f]{32}$"},
    "source_event_metric_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_metric_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_as_path_dataset_id": {"pattern": "^event_as_path_dataset_v1_[0-9a-f]{32}$"},
    "source_event_as_path_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_as_path_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_lifecycle_snapshot_id": {"pattern": "^event_lifecycle_snapshot_v1_[0-9a-f]{32}$"},
    "source_lifecycle_snapshot_content_sha256": {"$ref": "#/$defs/sha256"},
    "api_read_semantics": {"const": "precompiled_event_window_read_model_only"},
    "pagination_semantics": {"const": "stable_server_side_pages_maximum_60_items"},
    "path_evidence_semantics": {"const": "bounded_real_path_samples_full_evidence_remains_in_s3_audit_artifact"},
    "causal_boundary": {"const": "rrc25_path_association_is_not_dependency_propagation_user_impact_or_cause"},
    "event_count": {"type": "integer", "minimum": 1},
    "state_point_count": {"type": "integer", "minimum": 1},
    "affected_as_count": {"type": "integer", "minimum": 0},
    "path_downstream_relation_count": {"type": "integer", "minimum": 0},
    "path_sample_count": {"type": "integer", "minimum": 0},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "content_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^events/[A-Z]{2}/slot-[0-9]{12}-[0-9a-f]{12}/(overview|series)\\.json\\.gz$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "size_bytes", "sha256", "content_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^events/[A-Z]{2}/slot-[0-9]{12}-[0-9a-f]{12}/(affected-as|path-downstreams)\\.jsonl\\.gz$"},
        "row_count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "status", "event_read_model_id", "publication_id",
        "revision", "publication_state", "incident_id", "legacy_reference",
        "country_code", "cohort_id", "event_metric_id", "event_as_path_id",
        "window_start_utc", "window_end_utc", "data_through",
        "lifecycle_state", "is_final_in_data_range", "state_point_count",
        "affected_as_count", "path_downstream_relation_count",
        "path_sample_count", "overview", "series", "affected_as",
        "path_downstreams", "content_sha256"
      ],
      "properties": {
        "schema_version": {"const": "country-outage-general-event-read-model/v1"},
        "status": {"const": "complete"},
        "event_read_model_id": {"pattern": "^country_event_read_model_v1_[0-9a-f]{32}$"},
        "publication_id": {"pattern": "^country_outage_publication_v1_[0-9a-f]{32}$"},
        "revision": {"const": 1},
        "publication_state": {"const": "published"},
        "incident_id": {"type": "string", "minLength": 1},
        "legacy_reference": {"type": "string", "pattern": "^country_outage/"},
        "country_code": {"pattern": "^[A-Z]{2}$"},
        "cohort_id": {"pattern": "^country_event_cohort_v1_[0-9a-f]{32}$"},
        "event_metric_id": {"pattern": "^country_event_metric_v1_[0-9a-f]{32}$"},
        "event_as_path_id": {"pattern": "^country_event_as_path_v1_[0-9a-f]{32}$"},
        "window_start_utc": {"type": "string", "format": "date-time"},
        "window_end_utc": {"type": "string", "format": "date-time"},
        "data_through": {"type": "string", "format": "date-time"},
        "lifecycle_state": {"type": "string", "minLength": 1},
        "is_final_in_data_range": {"type": "boolean"},
        "state_point_count": {"type": "integer", "minimum": 1},
        "affected_as_count": {"type": "integer", "minimum": 0},
        "path_downstream_relation_count": {"type": "integer", "minimum": 0},
        "path_sample_count": {"type": "integer", "minimum": 0},
        "overview": {"$ref": "#/$defs/object_file"},
        "series": {"$ref": "#/$defs/object_file"},
        "affected_as": {"$ref": "#/$defs/row_file"},
        "path_downstreams": {"$ref": "#/$defs/row_file"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
