{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/data/rrc25-event-metric-store.schema.json",
  "title": "RRC25 国家中断事件前缀、AS 与 IP 指标制品",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "run_id",
    "dataset_id",
    "collector_id",
    "window_start_utc",
    "window_end_exclusive_utc",
    "implementation_id",
    "projector_name",
    "projector_version",
    "source_route_event_dataset_id",
    "source_route_event_content_sha256",
    "source_route_event_manifest_sha256",
    "source_route_state_dataset_id",
    "source_route_state_content_sha256",
    "source_route_state_manifest_sha256",
    "source_event_cohort_dataset_id",
    "source_event_cohort_content_sha256",
    "source_event_cohort_manifest_sha256",
    "source_peer_session_dataset_id",
    "source_peer_session_content_sha256",
    "mapping_version",
    "mapping_compatible_sha256",
    "mapping_revised_sha256",
    "route_state_authority",
    "direction_definition",
    "direction_visibility_semantics",
    "session_route_boundary",
    "new_prefix_semantics",
    "missing_semantics",
    "ipv4_resource_semantics",
    "ipv6_resource_semantics",
    "event_count",
    "state_point_count",
    "fixed_prefix_count",
    "expected_direction_relation_count",
    "series_row_count",
    "prefix_state_row_count",
    "asn_state_row_count",
    "new_prefix_state_row_count",
    "events",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rrc25-event-metric-store/v1"},
    "status": {"const": "complete"},
    "run_id": {"type": "string", "pattern": "^event_metric_run_v1_[0-9a-f]{32}$"},
    "dataset_id": {"type": "string", "pattern": "^event_metric_dataset_v1_[0-9a-f]{32}$"},
    "collector_id": {"const": "rrc25"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "implementation_id": {"$ref": "#/$defs/gitIdentity"},
    "projector_name": {"const": "domeye_country_outage_event_metric_projector"},
    "projector_version": {"const": "1.0.0"},
    "source_route_event_dataset_id": {"type": "string", "minLength": 1},
    "source_route_event_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_event_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_state_dataset_id": {"type": "string", "minLength": 1},
    "source_route_state_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_state_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_cohort_dataset_id": {"type": "string", "minLength": 1},
    "source_event_cohort_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_peer_session_dataset_id": {"type": "string", "minLength": 1},
    "source_peer_session_content_sha256": {"$ref": "#/$defs/sha256"},
    "mapping_version": {"$ref": "#/$defs/sha256"},
    "mapping_compatible_sha256": {"$ref": "#/$defs/sha256"},
    "mapping_revised_sha256": {"$ref": "#/$defs/sha256"},
    "route_state_authority": {"const": "the_existing_route_state_dataset_is_the_only_route_state_fact"},
    "direction_definition": {"const": "one_independent_direction_is_one_rrc25_peer_asn_and_multiple_bgp_sessions_do_not_expand_the_denominator"},
    "direction_visibility_semantics": {"const": "an_expected_direction_is_visible_when_current_route_state_has_any_visible_route_for_its_peer_asn_and_prefix_regardless_of_origin"},
    "session_route_boundary": {"const": "peer_session_observations_remain_separate_and_never_materialize_or_imply_route_withdrawals"},
    "new_prefix_semantics": {"const": "prefixes_first_observed_after_the_frozen_cohort_use_independent_current_and_cumulative_tracks_and_never_offset_fixed_cohort_interruptions"},
    "missing_semantics": {"const": "missing_or_incomplete_slots_are_unknown_with_null_values_and_are_never_coerced_to_zero"},
    "ipv4_resource_semantics": {"const": "deduplicated_unique_ipv4_address_union"},
    "ipv6_resource_semantics": {"const": "deduplicated_unique_ipv6_slash48_equivalent_union"},
    "event_count": {"type": "integer", "minimum": 1},
    "state_point_count": {"type": "integer", "minimum": 1},
    "fixed_prefix_count": {"type": "integer", "minimum": 1},
    "expected_direction_relation_count": {"type": "integer", "minimum": 1},
    "series_row_count": {"type": "integer", "minimum": 1},
    "prefix_state_row_count": {"type": "integer", "minimum": 1},
    "asn_state_row_count": {"type": "integer", "minimum": 1},
    "new_prefix_state_row_count": {"type": "integer", "minimum": 0},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/eventManifest"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitIdentity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "seriesValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_prefix_count", "normal_prefix_count", "interrupted_prefix_count",
        "partially_interrupted_prefix_count", "completely_interrupted_prefix_count",
        "unknown_prefix_count", "expected_direction_count", "visible_direction_count",
        "invisible_direction_count", "unknown_direction_count", "fixed_asn_count",
        "normal_asn_count", "affected_asn_count", "route_interrupted_asn_count",
        "unknown_asn_count", "fixed_visible_ipv4_address_count",
        "fixed_visible_ipv6_slash48_count", "new_visible_ipv4_prefix_count",
        "new_visible_ipv6_prefix_count", "new_visible_ipv4_address_count",
        "new_visible_ipv6_slash48_count", "new_cumulative_ipv4_prefix_count",
        "new_cumulative_ipv6_prefix_count", "new_cumulative_ipv4_address_count",
        "new_cumulative_ipv6_slash48_count"
      ],
      "properties": {
        "fixed_prefix_count": {"type": "integer", "minimum": 1},
        "normal_prefix_count": {"type": "integer", "minimum": 0},
        "interrupted_prefix_count": {"type": "integer", "minimum": 0},
        "partially_interrupted_prefix_count": {"type": "integer", "minimum": 0},
        "completely_interrupted_prefix_count": {"type": "integer", "minimum": 0},
        "unknown_prefix_count": {"type": "integer", "minimum": 0},
        "expected_direction_count": {"type": "integer", "minimum": 1},
        "visible_direction_count": {"type": "integer", "minimum": 0},
        "invisible_direction_count": {"type": "integer", "minimum": 0},
        "unknown_direction_count": {"type": "integer", "minimum": 0},
        "fixed_asn_count": {"type": "integer", "minimum": 1},
        "normal_asn_count": {"type": "integer", "minimum": 0},
        "affected_asn_count": {"type": "integer", "minimum": 0},
        "route_interrupted_asn_count": {"type": "integer", "minimum": 0},
        "unknown_asn_count": {"type": "integer", "minimum": 0},
        "fixed_visible_ipv4_address_count": {"type": "integer", "minimum": 0},
        "fixed_visible_ipv6_slash48_count": {"type": "integer", "minimum": 0},
        "new_visible_ipv4_prefix_count": {"type": "integer", "minimum": 0},
        "new_visible_ipv6_prefix_count": {"type": "integer", "minimum": 0},
        "new_visible_ipv4_address_count": {"type": "integer", "minimum": 0},
        "new_visible_ipv6_slash48_count": {"type": "integer", "minimum": 0},
        "new_cumulative_ipv4_prefix_count": {"type": "integer", "minimum": 0},
        "new_cumulative_ipv6_prefix_count": {"type": "integer", "minimum": 0},
        "new_cumulative_ipv4_address_count": {"type": "integer", "minimum": 0},
        "new_cumulative_ipv6_slash48_count": {"type": "integer", "minimum": 0}
      }
    },
    "eventManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "status", "directory", "event_metric_id", "legacy_reference",
        "country_code", "cohort_id", "cohort_content_sha256", "window_start_utc",
        "projection_end_state_point_utc", "state_point_count", "fixed_prefix_count",
        "fixed_asn_count", "expected_direction_relation_count", "new_prefix_count",
        "series", "prefix_states", "asn_states", "new_prefix_states", "final_values",
        "content_sha256"
      ],
      "properties": {
        "schema_version": {"const": "rrc25-event-metric/v1"},
        "status": {"const": "complete"},
        "directory": {"type": "string", "pattern": "^events/[A-Z]{2}/slot-[0-9]{4}-[0-9a-f]{12}$"},
        "event_metric_id": {"type": "string", "pattern": "^country_event_metric_v1_[0-9a-f]{32}$"},
        "legacy_reference": {"type": "string", "minLength": 1},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "cohort_id": {"type": "string", "minLength": 1},
        "cohort_content_sha256": {"$ref": "#/$defs/sha256"},
        "window_start_utc": {"type": "string", "format": "date-time"},
        "projection_end_state_point_utc": {"type": "string", "format": "date-time"},
        "state_point_count": {"type": "integer", "minimum": 1},
        "fixed_prefix_count": {"type": "integer", "minimum": 1},
        "fixed_asn_count": {"type": "integer", "minimum": 1},
        "expected_direction_relation_count": {"type": "integer", "minimum": 1},
        "new_prefix_count": {"type": "integer", "minimum": 0},
        "series": {"$ref": "#/$defs/file"},
        "prefix_states": {"$ref": "#/$defs/file"},
        "asn_states": {"$ref": "#/$defs/file"},
        "new_prefix_states": {"$ref": "#/$defs/file"},
        "final_values": {"$ref": "#/$defs/seriesValues"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
