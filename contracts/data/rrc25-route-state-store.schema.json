{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/rrc25-route-state-store.schema.json",
  "title": "Domeye RRC25 224-310 RouteState 制品库合同",
  "description": "S2 唯一 RouteState 事实及其可恢复 Checkpoint 的完成清单。Prefix×VP 是 RouteState 主键维度；本合同不定义 Prefix×VP Evidence、五分钟在线指标、事件或 Publication。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "run_id",
    "dataset_id",
    "collector_id",
    "window_start_utc",
    "window_end_exclusive_utc",
    "state_point_count",
    "source_route_event_dataset_id",
    "source_route_event_content_sha256",
    "source_route_event_manifest_sha256",
    "source_route_event_count",
    "implementation_id",
    "projector_name",
    "projector_version",
    "mapping_version",
    "mapping_compatible_sha256",
    "mapping_revised_sha256",
    "route_state_key",
    "checkpoint_slots",
    "checkpoints",
    "slot_ledgers",
    "processed_update_count",
    "processed_route_event_count",
    "attempted_through",
    "data_through",
    "route_state_record_count",
    "visible_route_count",
    "withdrawn_route_count",
    "final_state_digest",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "rrc25-route-state-store/v1" },
    "status": { "const": "complete" },
    "run_id": { "pattern": "^route_state_run_v1_[0-9a-f]{32}$" },
    "dataset_id": { "$ref": "#/$defs/datasetId" },
    "collector_id": { "const": "rrc25" },
    "window_start_utc": { "const": "2026-02-24T00:00:00Z" },
    "window_end_exclusive_utc": { "const": "2026-03-11T00:00:00Z" },
    "state_point_count": { "const": 4320 },
    "source_route_event_dataset_id": {
      "pattern": "^route_event_dataset_v1_[0-9a-f]{32}$"
    },
    "source_route_event_content_sha256": { "$ref": "#/$defs/sha256" },
    "source_route_event_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_route_event_count": { "type": "integer", "minimum": 1 },
    "implementation_id": { "$ref": "#/$defs/implementationId" },
    "projector_name": { "const": "domeye_route_state_projector" },
    "projector_version": { "const": "1.0.0" },
    "mapping_version": { "$ref": "#/$defs/sha256" },
    "mapping_compatible_sha256": { "$ref": "#/$defs/sha256" },
    "mapping_revised_sha256": { "$ref": "#/$defs/sha256" },
    "route_state_key": {
      "const": "collector + VP/peer + prefix + address_family"
    },
    "checkpoint_slots": {
      "const": [0, 2160, 4320]
    },
    "checkpoints": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/checkpointSlot0" },
        { "$ref": "#/$defs/checkpointSlot2160" },
        { "$ref": "#/$defs/checkpointSlot4320" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "slot_ledgers": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/ledgerFirst" },
        { "$ref": "#/$defs/ledgerSecond" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "processed_update_count": { "const": 4320 },
    "processed_route_event_count": { "type": "integer", "minimum": 1 },
    "attempted_through": { "const": "2026-03-11T00:00:00Z" },
    "data_through": { "const": "2026-03-11T00:00:00Z" },
    "route_state_record_count": { "type": "integer", "minimum": 1 },
    "visible_route_count": { "type": "integer", "minimum": 0 },
    "withdrawn_route_count": { "type": "integer", "minimum": 0 },
    "final_state_digest": { "$ref": "#/$defs/sha256" },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^route_state_dataset_v1_[0-9a-f]{32}$"
    },
    "implementationId": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}$"
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^route_state_checkpoint_v1_[0-9a-f]{32}$"
    },
    "checkpointBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "checkpoint_id",
        "processed_slot",
        "data_through",
        "route_state_record_count",
        "visible_route_count",
        "state_digest",
        "content_sha256"
      ],
      "properties": {
        "path": { "type": "string" },
        "checkpoint_id": { "$ref": "#/$defs/checkpointId" },
        "processed_slot": { "type": "integer", "minimum": 0, "maximum": 4320 },
        "data_through": { "type": "string" },
        "route_state_record_count": { "type": "integer", "minimum": 1 },
        "visible_route_count": { "type": "integer", "minimum": 0 },
        "state_digest": { "$ref": "#/$defs/sha256" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checkpointSlot0": {
      "allOf": [
        { "$ref": "#/$defs/checkpointBase" },
        {
          "properties": {
            "path": { "const": "checkpoints/slot-0000" },
            "processed_slot": { "const": 0 },
            "data_through": { "const": "2026-02-24T00:00:00Z" }
          }
        }
      ]
    },
    "checkpointSlot2160": {
      "allOf": [
        { "$ref": "#/$defs/checkpointBase" },
        {
          "properties": {
            "path": { "const": "checkpoints/slot-2160" },
            "processed_slot": { "const": 2160 },
            "data_through": { "const": "2026-03-03T12:00:00Z" }
          }
        }
      ]
    },
    "checkpointSlot4320": {
      "allOf": [
        { "$ref": "#/$defs/checkpointBase" },
        {
          "properties": {
            "path": { "const": "checkpoints/slot-4320" },
            "processed_slot": { "const": 4320 },
            "data_through": { "const": "2026-03-11T00:00:00Z" }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ledgerBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "route_state_dataset_id",
        "start_slot",
        "end_slot",
        "slot_count",
        "first_state_point_utc",
        "last_state_point_utc",
        "file",
        "content_sha256"
      ],
      "properties": {
        "schema_version": { "const": "rrc25-route-state-slot-ledger/v1" },
        "status": { "const": "complete" },
        "route_state_dataset_id": { "$ref": "#/$defs/datasetId" },
        "start_slot": { "type": "integer", "minimum": 1, "maximum": 4320 },
        "end_slot": { "type": "integer", "minimum": 1, "maximum": 4320 },
        "slot_count": { "const": 2160 },
        "first_state_point_utc": { "type": "string" },
        "last_state_point_utc": { "type": "string" },
        "file": { "$ref": "#/$defs/file" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ledgerFirst": {
      "allOf": [
        { "$ref": "#/$defs/ledgerBase" },
        {
          "properties": {
            "start_slot": { "const": 1 },
            "end_slot": { "const": 2160 },
            "first_state_point_utc": { "const": "2026-02-24T00:05:00Z" },
            "last_state_point_utc": { "const": "2026-03-03T12:00:00Z" }
          }
        }
      ]
    },
    "ledgerSecond": {
      "allOf": [
        { "$ref": "#/$defs/ledgerBase" },
        {
          "properties": {
            "start_slot": { "const": 2161 },
            "end_slot": { "const": 4320 },
            "first_state_point_utc": { "const": "2026-03-03T12:05:00Z" },
            "last_state_point_utc": { "const": "2026-03-11T00:00:00Z" }
          }
        }
      ]
    }
  }
}
