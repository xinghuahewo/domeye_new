{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/data/rrc25-read-model-store.schema.json",
  "title": "Domeye RRC25 224-310 S5 读模型候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "candidate_id",
    "run_id",
    "dataset_id",
    "implementation_id",
    "database_model",
    "collector_id",
    "window_start_utc",
    "window_end_exclusive_utc",
    "state_point_count",
    "country_bucket_count",
    "event_count",
    "event_country_count",
    "series_count",
    "report_snapshot_count",
    "report_pointer_count",
    "prefix_vp_evidence_view_count",
    "prefix_vp_evidence_row_count",
    "prefix_vp_evidence_catalog_sha256",
    "prefix_vp_evidence_content_sha256",
    "derived_from_route_state_id",
    "source_route_state_dataset_id",
    "source_route_state_content_sha256",
    "source_route_state_manifest_sha256",
    "source_event_publication_dataset_id",
    "source_event_publication_content_sha256",
    "source_event_publication_manifest_sha256",
    "source_event_publication_database_name",
    "source_event_publication_database_fingerprint_sha256",
    "source_metric_database_name",
    "source_metric_database_fingerprint_sha256",
    "api_read_semantics",
    "report_semantics",
    "prefix_vp_semantics",
    "files",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rrc25-read-model-store/v1"},
    "status": {"const": "complete"},
    "candidate_id": {"pattern": "^domeye_data_candidate_v1_[0-9a-f]{32}$"},
    "run_id": {"pattern": "^read_model_run_v1_[0-9a-f]{32}$"},
    "dataset_id": {"pattern": "^read_model_dataset_v1_[0-9a-f]{32}$"},
    "implementation_id": {"pattern": "^[0-9a-f]{40}$"},
    "database_model": {"const": "domeye-read-model-postgresql/v1"},
    "collector_id": {"const": "rrc25"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "state_point_count": {"const": 4320},
    "country_bucket_count": {"const": 241},
    "event_count": {"const": 81},
    "event_country_count": {"const": 43},
    "series_count": {"const": 43},
    "report_snapshot_count": {"const": 82},
    "report_pointer_count": {"const": 81},
    "prefix_vp_evidence_view_count": {"const": 81},
    "prefix_vp_evidence_row_count": {"type": "integer", "minimum": 1},
    "prefix_vp_evidence_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "prefix_vp_evidence_content_sha256": {"$ref": "#/$defs/sha256"},
    "derived_from_route_state_id": {"pattern": "^route_state_checkpoint_v1_[0-9a-f]{32}$"},
    "source_route_state_dataset_id": {"pattern": "^route_state_dataset_v1_[0-9a-f]{32}$"},
    "source_route_state_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_state_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_publication_dataset_id": {"pattern": "^event_publication_dataset_v1_[0-9a-f]{32}$"},
    "source_event_publication_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_publication_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_publication_database_name": {"type": "string", "minLength": 1},
    "source_event_publication_database_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "source_metric_database_name": {"type": "string", "minLength": 1},
    "source_metric_database_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "api_read_semantics": {"const": "precompiled_read_model_only"},
    "report_semantics": {"const": "immutable_snapshot_new_version_on_refresh"},
    "prefix_vp_semantics": {"const": "derived_view_not_independent_fact"},
    "files": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "row_count", "size_bytes", "sha256", "content_sha256"],
        "properties": {
          "role": {
            "enum": [
              "compact_series",
              "source_binding",
              "series_object",
              "prefix_vp_evidence_view",
              "event_read_model",
              "report_snapshot",
              "report_pointer",
              "prefix_vp_evidence_catalog"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "row_count": {"type": "integer", "minimum": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "content_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
