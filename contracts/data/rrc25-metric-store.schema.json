{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/rrc25-metric-store.schema.json",
  "title": "Domeye RRC25 224-310 统一指标文件候选合同",
  "description": "约束只从唯一 RouteState 转移确定性投影的国家、ASN、collector 五分钟指标、质量槽、双水位和 PostgreSQL/TimescaleDB 装载身份。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "candidate_id",
    "run_id",
    "dataset_id",
    "projection_id",
    "collector_id",
    "window_start_utc",
    "window_end_exclusive_utc",
    "first_state_point_utc",
    "last_state_point_utc",
    "state_point_count",
    "country_bucket_count",
    "country_metric_row_count",
    "asn_metric_change_row_count",
    "collector_metric_row_count",
    "metric_subject_count",
    "source_route_event_dataset_id",
    "source_route_event_content_sha256",
    "source_route_event_manifest_sha256",
    "source_route_state_dataset_id",
    "source_route_state_content_sha256",
    "source_route_state_manifest_sha256",
    "route_event_implementation_id",
    "route_state_implementation_id",
    "implementation_id",
    "projector_name",
    "projector_version",
    "mapping_version",
    "mapping_compatible_sha256",
    "mapping_revised_sha256",
    "route_state_key",
    "projection_source",
    "metric_definitions",
    "asn_encoding",
    "missing_semantics",
    "zero_semantics",
    "database_model",
    "files",
    "attempted_through",
    "data_through",
    "missing_slot_count",
    "finality",
    "final_route_state_record_count",
    "final_visible_route_count",
    "final_route_state_digest",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rrc25-route-metric-store/v1"},
    "status": {"const": "complete"},
    "candidate_id": {"pattern": "^domeye_data_candidate_v1_[0-9a-f]{32}$"},
    "run_id": {"pattern": "^route_metric_run_v1_[0-9a-f]{32}$"},
    "dataset_id": {"pattern": "^route_metric_dataset_v1_[0-9a-f]{32}$"},
    "projection_id": {"pattern": "^route_metric_projection_v1_[0-9a-f]{32}$"},
    "collector_id": {"const": "rrc25"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "first_state_point_utc": {"const": "2026-02-24T00:05:00Z"},
    "last_state_point_utc": {"const": "2026-03-11T00:00:00Z"},
    "state_point_count": {"const": 4320},
    "country_bucket_count": {"const": 241},
    "country_metric_row_count": {"const": 1041120},
    "asn_metric_change_row_count": {"type": "integer", "minimum": 1},
    "collector_metric_row_count": {"const": 4320},
    "metric_subject_count": {"type": "integer", "minimum": 243},
    "source_route_event_dataset_id": {"pattern": "^route_event_dataset_v1_[0-9a-f]{32}$"},
    "source_route_event_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_event_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_state_dataset_id": {"pattern": "^route_state_dataset_v1_[0-9a-f]{32}$"},
    "source_route_state_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_state_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "route_event_implementation_id": {"$ref": "#/$defs/implementation"},
    "route_state_implementation_id": {"$ref": "#/$defs/implementation"},
    "implementation_id": {"$ref": "#/$defs/implementation"},
    "projector_name": {"const": "domeye_route_metric_projector"},
    "projector_version": {"const": "1.0.0"},
    "mapping_version": {"$ref": "#/$defs/sha256"},
    "mapping_compatible_sha256": {"$ref": "#/$defs/sha256"},
    "mapping_revised_sha256": {"$ref": "#/$defs/sha256"},
    "route_state_key": {"const": "collector + VP/peer + prefix + address_family"},
    "projection_source": {"const": "same_route_state_apply_transition_only"},
    "metric_definitions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "asn_encoding": {"const": "first_slot_snapshot_plus_change_points_state_locf_flow_zero_on_complete_absence"},
    "missing_semantics": {"const": "missing_metric_slot_is_missing_not_zero_and_blocks_data_through"},
    "zero_semantics": {"const": "explicit_integer_zero_is_observed_zero; zero_baseline_ratio_is_not_applicable"},
    "database_model": {"const": "domeye-data-postgresql-timescaledb/v1"},
    "files": {
      "type": "array",
      "minItems": 61,
      "maxItems": 61,
      "items": {"$ref": "#/$defs/file"}
    },
    "attempted_through": {"const": "2026-03-11T00:00:00Z"},
    "data_through": {"const": "2026-03-11T00:00:00Z"},
    "missing_slot_count": {"const": 0},
    "finality": {"const": "final"},
    "final_route_state_record_count": {"type": "integer", "minimum": 1},
    "final_visible_route_count": {"type": "integer", "minimum": 1},
    "final_route_state_digest": {"$ref": "#/$defs/sha256"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "row_count", "size_bytes", "sha256", "content_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(metrics|quality|registry)/[A-Za-z0-9._-]+\\.tsv\\.gz$"
        },
        "role": {
          "enum": ["country_metric", "asn_metric_change", "collector_metric", "metric_slot", "metric_subject"]
        },
        "date_utc": {
          "type": "string",
          "pattern": "^2026-(02-(2[4-9])|03-(0[1-9]|10))$"
        },
        "row_count": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
