{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/data/rrc25-shadow-migration-acceptance.schema.json",
  "title": "RRC25 224-310 S6 端到端验收回执",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "candidate_id",
    "dataset_id",
    "database_name",
    "window_start_utc",
    "window_end_exclusive_utc",
    "state_point_count",
    "country_bucket_count",
    "selected_bundle_id",
    "selected_by_acceptance_runtime",
    "selected_by_production",
    "legacy_reconciliation",
    "source_immutability",
    "security_and_switch_drills",
    "runtime_access_audit",
    "runtime",
    "database",
    "dlae_results",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rrc25-data-layer-end-to-end-acceptance/v1"},
    "status": {"const": "passed"},
    "candidate_id": {"pattern": "^domeye_data_candidate_v1_[0-9a-f]{32}$"},
    "dataset_id": {"pattern": "^shadow_migration_dataset_v1_[0-9a-f]{32}$"},
    "database_name": {"pattern": "^domeye_dl_s6_[a-z0-9_]+$"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "state_point_count": {"const": 4320},
    "country_bucket_count": {"const": 241},
    "selected_bundle_id": {"pattern": "^release_bundle_v1_[0-9a-f]{32}$"},
    "selected_by_acceptance_runtime": {"const": true},
    "selected_by_production": {"const": false},
    "legacy_reconciliation": {
      "type": "object",
      "required": [
        "import_batch_id",
        "source_table_count",
        "legacy_country_outage_count",
        "reconciled_count",
        "trace_only_count",
        "quarantine_count",
        "source_field_reconciliation_count",
        "field_reconciliation_count",
        "source_snapshot_set_sha256"
      ],
      "properties": {
        "import_batch_id": {"pattern": "^shadow_import_batch_v1_[0-9a-f]{32}$"},
        "source_table_count": {"const": 37},
        "legacy_country_outage_count": {"const": 111},
        "reconciled_count": {"const": 81},
        "trace_only_count": {"const": 29},
        "quarantine_count": {"const": 1},
        "source_field_reconciliation_count": {"const": 534},
        "field_reconciliation_count": {"const": 666},
        "source_snapshot_set_sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_immutability": {
      "type": "object",
      "required": [
        "unchanged",
        "legacy_data_written",
        "legacy_schema_written",
        "privilege_change",
        "source_snapshot_set_sha256_before",
        "source_snapshot_set_sha256_after"
      ],
      "properties": {
        "unchanged": {"const": true},
        "legacy_data_written": {"const": false},
        "legacy_schema_written": {"const": false},
        "privilege_change": {"const": "none; source database ACL unchanged"},
        "source_snapshot_set_sha256_before": {"pattern": "^[0-9a-f]{64}$"},
        "source_snapshot_set_sha256_after": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "security_and_switch_drills": {
      "type": "object",
      "required": [
        "invalid_bundle_rejected",
        "pointer_unchanged_after_invalid",
        "forward_version",
        "rollback_version",
        "final_forward_version",
        "stale_switch_rejected",
        "direct_pointer_mutation_rejected",
        "immutable_formal_object_delete_rejected",
        "migration_reader_write_rejected",
        "runtime_write_rejected",
        "legacy_permission_matrix",
        "retention"
      ],
      "properties": {
        "pointer_unchanged_after_invalid": {"const": true},
        "forward_version": {"const": 2},
        "rollback_version": {"const": 3},
        "final_forward_version": {"const": 4},
        "legacy_permission_matrix": {
          "type": "object",
          "additionalProperties": {"const": false}
        },
        "retention": {
          "type": "object",
          "required": ["formal_eligible", "referenced_eligible"],
          "properties": {
            "formal_eligible": {"const": 0},
            "referenced_eligible": {"const": 0}
          }
        }
      }
    },
    "runtime_access_audit": {
      "type": "object",
      "required": ["row_count", "legacy_table_read_count", "raw_or_state_scan_count", "content_sha256"],
      "properties": {
        "row_count": {"const": 451},
        "legacy_table_read_count": {"const": 0},
        "raw_or_state_scan_count": {"const": 0},
        "content_sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["health", "performance", "direct_event_checks"],
      "properties": {
        "health": {
          "type": "object",
          "required": ["status", "collector_id", "selected_by_acceptance_runtime", "selected_by_production"],
          "properties": {
            "status": {"const": "ok"},
            "collector_id": {"const": "rrc25"},
            "selected_by_acceptance_runtime": {"const": true},
            "selected_by_production": {"const": false}
          }
        },
        "direct_event_checks": {
          "type": "object",
          "required": ["IR", "MW"]
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["schema_sha256", "fingerprint_sha256", "summary"],
      "properties": {
        "schema_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "fingerprint_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "summary": {
          "type": "object",
          "required": [
            "complete_candidate_count",
            "import_batch_count",
            "source_table_snapshot_count",
            "source_field_reconciliation_count",
            "open_source_field_reconciliation_count",
            "role_contract_count",
            "runtime_selection_count",
            "production_selection_count",
            "dlae_pass_count"
          ],
          "properties": {
            "complete_candidate_count": {"const": 1},
            "import_batch_count": {"const": 1},
            "source_table_snapshot_count": {"const": 37},
            "source_field_reconciliation_count": {"const": 534},
            "open_source_field_reconciliation_count": {"const": 0},
            "role_contract_count": {"const": 3},
            "runtime_selection_count": {"const": 1},
            "production_selection_count": {"const": 0},
            "dlae_pass_count": {"const": 16}
          }
        }
      }
    },
    "dlae_results": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["acceptance_id", "status", "candidate_id", "evidence_refs"],
        "properties": {
          "acceptance_id": {"pattern": "^DLAE-(0[1-9]|1[0-6])$"},
          "status": {"const": "passed"},
          "candidate_id": {"pattern": "^domeye_data_candidate_v1_[0-9a-f]{32}$"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "content_sha256": {"pattern": "^[0-9a-f]{64}$"}
  }
}
