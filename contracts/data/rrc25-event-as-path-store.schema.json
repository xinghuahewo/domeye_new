{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/data/rrc25-event-as-path-store.schema.json",
  "title": "RRC25 国家中断事件 AS 属性与路径关联制品",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "run_id", "dataset_id", "collector_id",
    "window_start_utc", "window_end_exclusive_utc", "implementation_id",
    "projector_name", "projector_version",
    "source_route_event_dataset_id", "source_route_event_content_sha256",
    "source_route_event_manifest_sha256", "source_event_cohort_dataset_id",
    "source_event_cohort_content_sha256", "source_event_cohort_manifest_sha256",
    "source_event_metric_dataset_id", "source_event_metric_content_sha256",
    "source_event_metric_manifest_sha256", "as_attribute_snapshot_name",
    "as_attribute_snapshot_sha256", "as_attribute_snapshot_size_bytes",
    "as_attribute_duplicate_policy", "as_attribute_field_semantics",
    "path_relationship_semantics", "unordered_path_policy", "causal_boundary",
    "event_count", "affected_as_count", "path_downstream_relation_count",
    "concurrent_downstream_relation_count", "path_evidence_count",
    "known_as_path_observation_count", "unknown_as_path_observation_count",
    "resolved_as_path_count", "scanned_as_path_partition_count",
    "scanned_as_path_row_count", "events", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rrc25-event-as-path-store/v1"},
    "status": {"const": "complete"},
    "run_id": {"pattern": "^event_as_path_run_v1_[0-9a-f]{32}$"},
    "dataset_id": {"pattern": "^event_as_path_dataset_v1_[0-9a-f]{32}$"},
    "collector_id": {"const": "rrc25"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "implementation_id": {"pattern": "^git:[0-9a-f]{40}$"},
    "projector_name": {"const": "domeye_country_outage_event_as_path_projector"},
    "projector_version": {"const": "1.0.0"},
    "source_route_event_dataset_id": {"pattern": "^route_event_dataset_v1_[0-9a-f]{32}$"},
    "source_route_event_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_route_event_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_cohort_dataset_id": {"pattern": "^event_cohort_dataset_v1_[0-9a-f]{32}$"},
    "source_event_cohort_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_metric_dataset_id": {"pattern": "^event_metric_dataset_v1_[0-9a-f]{32}$"},
    "source_event_metric_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_event_metric_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "as_attribute_snapshot_name": {"const": "as_entity.csv"},
    "as_attribute_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "as_attribute_snapshot_size_bytes": {"type": "integer", "minimum": 1},
    "as_attribute_duplicate_policy": {"const": "first_valid_row_wins_matching_existing_as_feature_loader"},
    "as_attribute_field_semantics": {"const": "name_organization_and_nature_are_selected_from_the_frozen_existing_as_entity_snapshot_and_missing_values_remain_unknown"},
    "path_relationship_semantics": {"const": "downstream_is_the_known_route_origin_when_an_ordered_rrc25_as_path_contains_the_affected_as_before_that_origin"},
    "unordered_path_policy": {"const": "as_set_confederation_or_missing_path_never_creates_an_ordered_downstream_relationship"},
    "causal_boundary": {"const": "path_containment_is_observed_control_plane_association_not_dependency_propagation_impact_or_cause"},
    "event_count": {"type": "integer", "minimum": 1},
    "affected_as_count": {"type": "integer", "minimum": 0},
    "path_downstream_relation_count": {"type": "integer", "minimum": 0},
    "concurrent_downstream_relation_count": {"type": "integer", "minimum": 0},
    "path_evidence_count": {"type": "integer", "minimum": 0},
    "known_as_path_observation_count": {"type": "integer", "minimum": 0},
    "unknown_as_path_observation_count": {"type": "integer", "minimum": 0},
    "resolved_as_path_count": {"type": "integer", "minimum": 0},
    "scanned_as_path_partition_count": {"type": "integer", "minimum": 0},
    "scanned_as_path_row_count": {"type": "integer", "minimum": 0},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_text": {"type": ["string", "null"], "minLength": 1},
    "value_state": {"enum": ["observed", "unknown"]},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^events/[A-Z]{2}/slot-[0-9]{4}-[0-9a-f]{12}/[a-z-]+\\.jsonl\\.gz$"},
        "row_count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "status", "directory", "event_as_path_id",
        "event_metric_id", "legacy_reference", "country_code", "cohort_id",
        "window_start_utc", "projection_end_state_point_utc", "affected_as_count",
        "route_interrupted_as_count", "affected_only_as_count",
        "unknown_static_name_count", "unknown_static_organization_count",
        "unknown_static_nature_count", "path_downstream_relation_count",
        "path_downstream_asn_count", "concurrent_downstream_relation_count",
        "path_evidence_count", "known_as_path_observation_count",
        "unknown_as_path_observation_count", "ordered_relationship_observation_count",
        "ambiguous_path_observation_count", "affected_as", "path_downstreams",
        "path_evidence", "content_sha256"
      ],
      "properties": {
        "schema_version": {"const": "rrc25-event-as-path/v1"},
        "status": {"const": "complete"},
        "directory": {"type": "string", "pattern": "^events/[A-Z]{2}/slot-[0-9]{4}-[0-9a-f]{12}$"},
        "event_as_path_id": {"pattern": "^country_event_as_path_v1_[0-9a-f]{32}$"},
        "event_metric_id": {"pattern": "^country_event_metric_v1_[0-9a-f]{32}$"},
        "legacy_reference": {"type": "string", "minLength": 1},
        "country_code": {"pattern": "^[A-Z]{2}$"},
        "cohort_id": {"pattern": "^country_event_cohort_v1_[0-9a-f]{32}$"},
        "window_start_utc": {"type": "string", "format": "date-time"},
        "projection_end_state_point_utc": {"type": "string", "format": "date-time"},
        "affected_as_count": {"type": "integer", "minimum": 0},
        "route_interrupted_as_count": {"type": "integer", "minimum": 0},
        "affected_only_as_count": {"type": "integer", "minimum": 0},
        "unknown_static_name_count": {"type": "integer", "minimum": 0},
        "unknown_static_organization_count": {"type": "integer", "minimum": 0},
        "unknown_static_nature_count": {"type": "integer", "minimum": 0},
        "path_downstream_relation_count": {"type": "integer", "minimum": 0},
        "path_downstream_asn_count": {"type": "integer", "minimum": 0},
        "concurrent_downstream_relation_count": {"type": "integer", "minimum": 0},
        "path_evidence_count": {"type": "integer", "minimum": 0},
        "known_as_path_observation_count": {"type": "integer", "minimum": 0},
        "unknown_as_path_observation_count": {"type": "integer", "minimum": 0},
        "ordered_relationship_observation_count": {"type": "integer", "minimum": 0},
        "ambiguous_path_observation_count": {"type": "integer", "minimum": 0},
        "affected_as": {"$ref": "#/$defs/file"},
        "path_downstreams": {"$ref": "#/$defs/file"},
        "path_evidence": {"$ref": "#/$defs/file"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "affected_as_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "event_as_path_id", "event_metric_id", "cohort_id", "asn",
        "as_name", "organization", "nature", "name_state", "organization_state",
        "nature_state", "event_classification", "fixed_prefix_count",
        "peak_partial_prefix_count", "peak_complete_prefix_count",
        "peak_invisible_direction_count", "path_downstream_asn_count",
        "concurrent_downstream_asn_count", "static_attribute_snapshot_sha256"
      ],
      "properties": {
        "schema_version": {"const": "rrc25-event-affected-as/v1"},
        "event_as_path_id": {"pattern": "^country_event_as_path_v1_[0-9a-f]{32}$"},
        "event_metric_id": {"pattern": "^country_event_metric_v1_[0-9a-f]{32}$"},
        "cohort_id": {"pattern": "^country_event_cohort_v1_[0-9a-f]{32}$"},
        "asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "as_name": {"$ref": "#/$defs/nullable_text"},
        "organization": {"$ref": "#/$defs/nullable_text"},
        "nature": {"$ref": "#/$defs/nullable_text"},
        "name_state": {"$ref": "#/$defs/value_state"},
        "organization_state": {"$ref": "#/$defs/value_state"},
        "nature_state": {"$ref": "#/$defs/value_state"},
        "event_classification": {"enum": ["affected", "route_interrupted"]},
        "fixed_prefix_count": {"type": "integer", "minimum": 1},
        "peak_partial_prefix_count": {"type": "integer", "minimum": 0},
        "peak_complete_prefix_count": {"type": "integer", "minimum": 0},
        "peak_invisible_direction_count": {"type": "integer", "minimum": 0},
        "path_downstream_asn_count": {"type": "integer", "minimum": 0},
        "concurrent_downstream_asn_count": {"type": "integer", "minimum": 0},
        "static_attribute_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "downstream_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "event_as_path_id", "event_metric_id", "cohort_id",
        "affected_asn", "downstream_asn", "downstream_as_name",
        "downstream_organization", "downstream_nature", "downstream_name_state",
        "downstream_organization_state", "downstream_nature_state", "observed_path_count",
        "associated_fixed_prefix_count", "independent_direction_count",
        "route_observation_count", "concurrent_state_point_count",
        "first_concurrent_state_point_utc", "last_concurrent_state_point_utc",
        "peak_concurrent_interrupted_prefix_count", "peak_concurrent_ipv4_address_count",
        "peak_concurrent_ipv6_slash48_count", "path_relationship_semantics"
      ],
      "properties": {
        "schema_version": {"const": "rrc25-event-path-downstream/v1"},
        "event_as_path_id": {"pattern": "^country_event_as_path_v1_[0-9a-f]{32}$"},
        "event_metric_id": {"pattern": "^country_event_metric_v1_[0-9a-f]{32}$"},
        "cohort_id": {"pattern": "^country_event_cohort_v1_[0-9a-f]{32}$"},
        "affected_asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "downstream_asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "downstream_as_name": {"$ref": "#/$defs/nullable_text"},
        "downstream_organization": {"$ref": "#/$defs/nullable_text"},
        "downstream_nature": {"$ref": "#/$defs/nullable_text"},
        "downstream_name_state": {"$ref": "#/$defs/value_state"},
        "downstream_organization_state": {"$ref": "#/$defs/value_state"},
        "downstream_nature_state": {"$ref": "#/$defs/value_state"},
        "observed_path_count": {"type": "integer", "minimum": 1},
        "associated_fixed_prefix_count": {"type": "integer", "minimum": 1},
        "independent_direction_count": {"type": "integer", "minimum": 1},
        "route_observation_count": {"type": "integer", "minimum": 1},
        "concurrent_state_point_count": {"type": "integer", "minimum": 0},
        "first_concurrent_state_point_utc": {"type": ["string", "null"], "format": "date-time"},
        "last_concurrent_state_point_utc": {"type": ["string", "null"], "format": "date-time"},
        "peak_concurrent_interrupted_prefix_count": {"type": "integer", "minimum": 0},
        "peak_concurrent_ipv4_address_count": {"type": "integer", "minimum": 0},
        "peak_concurrent_ipv6_slash48_count": {"type": "integer", "minimum": 0},
        "path_relationship_semantics": {"const": "ordered_rrc25_as_path_contains_affected_as_before_known_origin"}
      }
    },
    "path_evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "event_as_path_id", "cohort_id", "affected_asn",
        "downstream_asn", "cohort_member_id", "prefix", "address_family",
        "as_path_id", "as_path_canonical", "independent_peer_asns",
        "route_observation_count", "relationship_state"
      ],
      "properties": {
        "schema_version": {"const": "rrc25-event-path-evidence/v1"},
        "event_as_path_id": {"pattern": "^country_event_as_path_v1_[0-9a-f]{32}$"},
        "cohort_id": {"pattern": "^country_event_cohort_v1_[0-9a-f]{32}$"},
        "affected_asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "downstream_asn": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "cohort_member_id": {"pattern": "^event_cohort_member_v1_[0-9a-f]{32}$"},
        "prefix": {"type": "string", "minLength": 3},
        "address_family": {"enum": ["ipv4", "ipv6"]},
        "as_path_id": {"pattern": "^asp_v1_[0-9a-f]{64}$"},
        "as_path_canonical": {"type": "string", "minLength": 1},
        "independent_peer_asns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
        "route_observation_count": {"type": "integer", "minimum": 1},
        "relationship_state": {"const": "observed_ordered_path_association"}
      }
    }
  }
}
