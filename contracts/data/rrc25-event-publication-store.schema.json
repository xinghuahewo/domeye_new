{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/data/rrc25-event-publication-store.schema.json",
  "title": "Domeye RRC25 224-310 事件与 Publication 候选清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "database_model",
    "candidate_id",
    "run_id",
    "dataset_id",
    "implementation_id",
    "collector_id",
    "window_start_utc",
    "window_end_exclusive_utc",
    "state_point_count",
    "country_bucket_count",
    "event_count",
    "event_country_count",
    "legacy_publication_count",
    "observation_publication_count",
    "analysis_publication_count",
    "event_fact_count",
    "lifecycle_stage_counts",
    "corrected_revision_incident_counts",
    "source_metric_dataset_id",
    "source_metric_content_sha256",
    "source_metric_manifest_sha256",
    "source_metric_database_name",
    "source_metric_database_fingerprint_sha256",
    "source_metric_receipt_id",
    "source_metric_receipt_content_sha256",
    "source_metric_receipt_file_sha256",
    "legacy_registry_uri",
    "legacy_registry_sha256",
    "lifecycle_algorithm",
    "analysis_algorithm",
    "analysis_cadence_slots",
    "formal_recovery_assessment",
    "normal_append_revision_semantics",
    "correction_revision_semantics",
    "current_pointer_semantics",
    "content_sha256",
    "files",
    "built_at"
  ],
  "properties": {
    "schema_version": {"const": "rrc25-event-publication-store/v1"},
    "status": {"const": "complete"},
    "database_model": {"const": "domeye-event-publication-postgresql/v1"},
    "candidate_id": {"pattern": "^domeye_data_candidate_v1_[0-9a-f]{32}$"},
    "run_id": {"pattern": "^event_publication_run_v1_[0-9a-f]{32}$"},
    "dataset_id": {"pattern": "^event_publication_dataset_v1_[0-9a-f]{32}$"},
    "implementation_id": {"pattern": "^[0-9a-f]{40}$"},
    "collector_id": {"const": "rrc25"},
    "window_start_utc": {"const": "2026-02-24T00:00:00Z"},
    "window_end_exclusive_utc": {"const": "2026-03-11T00:00:00Z"},
    "state_point_count": {"const": 4320},
    "country_bucket_count": {"const": 241},
    "event_count": {"const": 81},
    "event_country_count": {"const": 43},
    "legacy_publication_count": {"const": 82},
    "observation_publication_count": {"type": "integer", "minimum": 81},
    "analysis_publication_count": {"type": "integer", "minimum": 81},
    "event_fact_count": {"const": 243},
    "lifecycle_stage_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected", "ongoing", "recovery_candidate", "recovered_observation", "final"],
      "properties": {
        "detected": {"const": 81},
        "ongoing": {"const": 81},
        "recovery_candidate": {"const": 0},
        "recovered_observation": {"const": 0},
        "final": {"const": 81}
      }
    },
    "corrected_revision_incident_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "source_metric_dataset_id": {"pattern": "^route_metric_dataset_v1_[0-9a-f]{32}$"},
    "source_metric_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_metric_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_metric_database_name": {"type": "string", "minLength": 1},
    "source_metric_database_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "source_metric_receipt_id": {"pattern": "^route_metric_load_receipt_v1_[0-9a-f]{32}$"},
    "source_metric_receipt_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_metric_receipt_file_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_registry_uri": {"type": "string", "minLength": 1},
    "legacy_registry_sha256": {"$ref": "#/$defs/sha256"},
    "lifecycle_algorithm": {"const": "rrc25_country_outage_lifecycle/v1"},
    "analysis_algorithm": {"const": "rrc25_country_trend_profile/v1"},
    "analysis_cadence_slots": {"const": 12},
    "formal_recovery_assessment": {"const": "not_assessed_without_trusted_normal_band"},
    "normal_append_revision_semantics": {"const": "same_revision_new_publication_id"},
    "correction_revision_semantics": {"const": "new_revision_with_correction_of_and_final_supersedes"},
    "current_pointer_semantics": {"const": "validated_atomic_advance_only"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/file"}
    },
    "built_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "row_count", "size_bytes", "sha256", "content_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[a-z-]+\\.tsv\\.gz$"},
        "role": {
          "enum": [
            "source_binding",
            "incident",
            "event_fact",
            "legacy_publication",
            "observation_publication",
            "analysis_publication",
            "pointer_plan"
          ]
        },
        "row_count": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
