{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.example/contracts/data/rrc25-peer-session-store.schema.json",
  "title": "Domeye RRC25 224-310 会话状态变化事实合同",
  "description": "只从冻结的 4320 个 RRC25 UPDATE MRT 提取逐条 BGP4MP STATE_CHANGE。会话事实与 RouteEvent、RouteState 分离；会话掉线不得生成或暗示前缀 WITHDRAW。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "run_id",
    "dataset_id",
    "collector_id",
    "window_start_utc",
    "window_end_exclusive_utc",
    "state_point_count",
    "selection_sha256",
    "source_manifest_sha256",
    "source_route_event_dataset_id",
    "source_route_event_content_sha256",
    "source_route_event_manifest_sha256",
    "implementation_id",
    "extractor_name",
    "extractor_version",
    "observation_semantics",
    "prefix_withdrawal_inference",
    "update_artifact_count",
    "physical_record_count",
    "observation_count",
    "unique_session_count",
    "unique_peer_asn_count",
    "transition_counts",
    "partitions",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "rrc25-peer-session-store/v1" },
    "status": { "const": "complete" },
    "run_id": { "pattern": "^peer_session_run_v1_[0-9a-f]{32}$" },
    "dataset_id": { "$ref": "#/$defs/datasetId" },
    "collector_id": { "const": "rrc25" },
    "window_start_utc": { "const": "2026-02-24T00:00:00Z" },
    "window_end_exclusive_utc": { "const": "2026-03-11T00:00:00Z" },
    "state_point_count": { "const": 4320 },
    "selection_sha256": { "$ref": "#/$defs/sha256" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_route_event_dataset_id": {
      "pattern": "^route_event_dataset_v1_[0-9a-f]{32}$"
    },
    "source_route_event_content_sha256": { "$ref": "#/$defs/sha256" },
    "source_route_event_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "implementation_id": { "$ref": "#/$defs/implementationId" },
    "extractor_name": { "const": "domeye_peer_session_state_change_extractor" },
    "extractor_version": { "const": "1.0.0" },
    "observation_semantics": { "const": "single_peer_session_transition" },
    "prefix_withdrawal_inference": { "const": "not_permitted" },
    "update_artifact_count": { "const": 4320 },
    "physical_record_count": { "type": "integer", "minimum": 1 },
    "observation_count": { "type": "integer", "minimum": 0 },
    "unique_session_count": { "type": "integer", "minimum": 0 },
    "unique_peer_asn_count": { "type": "integer", "minimum": 0 },
    "transition_counts": { "$ref": "#/$defs/transitionCounts" },
    "partitions": {
      "type": "array",
      "minItems": 4320,
      "maxItems": 4320,
      "items": { "$ref": "#/$defs/partition" }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementationId": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}$"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^peer_session_dataset_v1_[0-9a-f]{32}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_time_utc",
        "artifact_type",
        "collector_id",
        "compression",
        "file_sha256",
        "relative_path",
        "size_bytes"
      ],
      "properties": {
        "artifact_id": { "pattern": "^art_v1_[0-9a-f]{32}$" },
        "artifact_time_utc": { "$ref": "#/$defs/utcTimestamp" },
        "artifact_type": { "const": "update" },
        "collector_id": { "const": "rrc25" },
        "compression": { "const": "gz" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "relative_path": {
          "type": "string",
          "pattern": "^rrc25/[0-9]{4}\\.[0-9]{2}/updates\\.[0-9]{12}\\.gz$"
        },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^partitions/[0-9]{4}/observations\\.jsonl\\.gz$"
        },
        "row_count": { "type": "integer", "minimum": 0 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "transitionCounts": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-6]->[1-6]$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "dataset_id",
        "artifact_index",
        "artifact",
        "input_integrity_status",
        "physical_record_count",
        "observation_count",
        "transition_counts",
        "observations",
        "content_sha256"
      ],
      "properties": {
        "schema_version": { "const": "rrc25-peer-session-partition/v1" },
        "dataset_id": { "$ref": "#/$defs/datasetId" },
        "artifact_index": { "type": "integer", "minimum": 0, "maximum": 4319 },
        "artifact": { "$ref": "#/$defs/artifact" },
        "input_integrity_status": {
          "const": "gzip_passed_and_stream_sha256_verified"
        },
        "physical_record_count": { "type": "integer", "minimum": 1 },
        "observation_count": { "type": "integer", "minimum": 0 },
        "transition_counts": { "$ref": "#/$defs/transitionCounts" },
        "observations": { "$ref": "#/$defs/file" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "session_id",
        "collector_id",
        "vp_id",
        "event_time_utc",
        "event_epoch_microseconds",
        "peer_asn",
        "local_asn",
        "interface_index",
        "afi",
        "peer_ip",
        "local_ip",
        "old_state",
        "old_state_name",
        "new_state",
        "new_state_name",
        "artifact_id",
        "file_sha256",
        "record_ordinal",
        "uncompressed_offset",
        "record_length",
        "raw_record_sha256",
        "semantics",
        "prefix_withdrawal_inference"
      ],
      "properties": {
        "observation_id": { "pattern": "^pso_v1_[0-9a-f]{32}$" },
        "session_id": { "pattern": "^session_v1_[0-9a-f]{32}$" },
        "collector_id": { "const": "rrc25" },
        "vp_id": { "pattern": "^vp_v1_[0-9a-f]{32}$" },
        "event_time_utc": { "$ref": "#/$defs/utcTimestamp" },
        "event_epoch_microseconds": { "type": "integer", "minimum": 0 },
        "peer_asn": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "local_asn": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "interface_index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "afi": { "enum": [1, 2] },
        "peer_ip": { "type": "string", "minLength": 2 },
        "local_ip": { "type": "string", "minLength": 2 },
        "old_state": { "type": "integer", "minimum": 1, "maximum": 6 },
        "old_state_name": {
          "enum": ["idle", "connect", "active", "open_sent", "open_confirm", "established"]
        },
        "new_state": { "type": "integer", "minimum": 1, "maximum": 6 },
        "new_state_name": {
          "enum": ["idle", "connect", "active", "open_sent", "open_confirm", "established"]
        },
        "artifact_id": { "pattern": "^art_v1_[0-9a-f]{32}$" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "record_ordinal": { "type": "integer", "minimum": 0 },
        "uncompressed_offset": { "type": "integer", "minimum": 0 },
        "record_length": { "type": "integer", "minimum": 12 },
        "raw_record_sha256": { "$ref": "#/$defs/sha256" },
        "semantics": { "const": "single_peer_session_transition" },
        "prefix_withdrawal_inference": { "const": "not_permitted" }
      }
    }
  }
}
