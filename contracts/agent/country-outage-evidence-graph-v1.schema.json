{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/agent/country-outage-evidence-graph-v1.schema.json",
  "title": "国家中断趋势 Evidence Graph v1",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm_version",
    "graph_id",
    "profile_id",
    "analysis_id",
    "snapshot",
    "nodes",
    "edges",
    "node_types",
    "relation_types",
    "hypothesis_nodes_allowed",
    "causal_relations_allowed"
  ],
  "properties": {
    "schema_version": {"const": "country_outage_evidence_graph_v1"},
    "algorithm_version": {"const": "country_outage_trend_product_s4_v1"},
    "graph_id": {"type": "string", "pattern": "^evidence_graph_v1_[0-9a-f]{32}$"},
    "profile_id": {"type": "string"},
    "analysis_id": {"type": "string"},
    "snapshot": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["from", "relation", "to"],
        "properties": {
          "from": {"type": "string"},
          "relation": {"enum": ["supported_by", "limited_by", "unknown_about"]},
          "to": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "node_types": {
      "const": ["Claim", "Evidence", "Limitation", "Unknown"]
    },
    "relation_types": {
      "const": ["supported_by", "limited_by", "unknown_about"]
    },
    "hypothesis_nodes_allowed": {"const": false},
    "causal_relations_allowed": {"const": false}
  },
  "$defs": {
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/claim"},
        {"$ref": "#/$defs/evidence"},
        {"$ref": "#/$defs/limitation"},
        {"$ref": "#/$defs/unknown"}
      ]
    },
    "claim": {
      "type": "object",
      "required": ["node_id", "node_type", "claim_kind", "text", "values", "evidence_refs", "limitation_refs", "unknown_refs", "conclusion_level"],
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {"const": "Claim"},
        "claim_kind": {"type": "string"},
        "text": {"type": "string"},
        "values": {"type": "object"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitation_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "unknown_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "conclusion_level": {"const": "rrc25_control_plane_observation"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["node_id", "node_type", "evidence_kind", "label", "snapshot_ref", "payload", "source_refs"],
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {"const": "Evidence"},
        "evidence_kind": {"type": "string"},
        "label": {"type": "string"},
        "snapshot_ref": {"type": "object"},
        "payload": {"type": "object"},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": ["node_id", "node_type", "code", "text"],
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {"const": "Limitation"},
        "code": {"type": "string"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "required": ["node_id", "node_type", "code", "text"],
      "properties": {
        "node_id": {"type": "string"},
        "node_type": {"const": "Unknown"},
        "code": {"type": "string"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
