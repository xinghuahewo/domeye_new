{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domeye.local/contracts/country-outage-contemporaneous-reference-v1.schema.json",
  "title": "国家中断同期投影参照上下文 v1",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm_version",
    "context_id",
    "context_type",
    "profile_id",
    "analysis_id",
    "snapshot",
    "time_grid",
    "reference_identity",
    "status",
    "target_country_code",
    "projection_bucket_count",
    "comparable_country_count",
    "excluded_projection_count",
    "exclusion_reason_counts",
    "excluded_projections",
    "normalization",
    "target",
    "distribution_positions",
    "curve_shape_distribution",
    "common_fluctuation",
    "source_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "country_outage_contemporaneous_reference_v1"},
    "algorithm_version": {"const": "country_outage_contemporaneous_reference_s5_v1"},
    "context_id": {"type": "string", "pattern": "^trend_context_v1_[0-9a-f]{32}$"},
    "context_type": {"const": "contemporaneous_country_projection_reference"},
    "profile_id": {"type": "string"},
    "analysis_id": {"type": "string"},
    "snapshot": {"type": "object"},
    "time_grid": {"type": "object"},
    "reference_identity": {
      "type": "object",
      "required": [
        "run_id",
        "dataset_id",
        "revision",
        "collector_id",
        "mapping_version",
        "data_through",
        "formal_manifest_sha256",
        "catalog_sha256",
        "complete_sha256",
        "source_reference",
        "artifact_status",
        "quality_status",
        "consumed_deliverable_hashes_verified"
      ],
      "properties": {
        "collector_id": {"const": "rrc25"},
        "run_id": {"type": "string"},
        "dataset_id": {"type": "string"},
        "revision": {"type": "string"},
        "mapping_version": {"type": "string"},
        "data_through": {"type": "string"},
        "formal_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "complete_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_reference": {"type": "string"},
        "artifact_status": {"const": "historical_accepted_artifact"},
        "quality_status": {"const": "pass"},
        "consumed_deliverable_hashes_verified": {"const": true}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["complete", "insufficient_data"]},
    "target_country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "projection_bucket_count": {"type": "integer", "minimum": 1},
    "comparable_country_count": {"type": "integer", "minimum": 0},
    "excluded_projection_count": {"type": "integer", "minimum": 0},
    "exclusion_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "excluded_projections": {"type": "array", "items": {"type": "object"}},
    "normalization": {
      "type": "object",
      "required": [
        "visibility",
        "decline_magnitude",
        "persistence",
        "asn_migration",
        "curve_shape",
        "distribution_position",
        "small_denominator_exclusive_upper_bound"
      ]
    },
    "target": {"type": ["object", "null"]},
    "distribution_positions": {"type": ["object", "null"]},
    "curve_shape_distribution": {"type": "array", "items": {"type": "object"}},
    "common_fluctuation": {"type": ["object", "null"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "limitations": {
      "type": "array",
      "contains": {"const": "contemporaneous_distribution_is_not_historical_normal_baseline"}
    }
  },
  "additionalProperties": false
}
