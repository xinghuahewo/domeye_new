{
  "name": "domeye-core-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Domeye 路由异常检测核心精简版前端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "api:types": "openapi-typescript ../contracts/openapi.json -o src/types/openapi.generated.d.ts",
    "preview": "vite preview",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "echarts": "^6.1.0",
    "vue": "^3.2.47",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@types/node": "^18.15.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.2.47",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.0.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
